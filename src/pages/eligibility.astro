const faqItems: FaqItem[] = [
  { question: "Who qualifies for a free or low-cost tablet in 2026?", answer: "Most people qualify through Lifeline eligibility routes, not a single nationwide free tablet for everyone program. You may qualify if your household participates in SNAP/EBT, Medicaid, SSI, Federal Public Housing Assistance, Veterans Pension, Survivors Benefit, certain Tribal programs, or if your income is at or below 135% of the Federal Poverty Guidelines. Tablet offers are not guaranteed and depend on provider availability, ZIP code, documents, inventory, shipping, activation, and possible co-pay." },
  { question: "Can I get a free tablet with EBT or SNAP?", answer: "SNAP or EBT participation may help prove Lifeline eligibility, but it does not automatically guarantee a tablet. Provider stock, ZIP code, state rules, plan terms, shipping, activation, and possible co-pay still matter." },
  { question: "Can I get a free tablet with Medicaid?", answer: "Medicaid is a regular Lifeline qualifying program. A tablet is still not guaranteed because device availability depends on provider offers, inventory, state or ZIP-code availability, documents, and current terms." },
