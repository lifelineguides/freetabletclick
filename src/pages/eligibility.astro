        <div class="overflow-hidden rounded-2xl border border-border bg-white shadow-sm"><table class="w-full text-left text-sm"><thead class="bg-slate-900 text-white"><tr><th class="px-4 py-4 font-bold">Household size</th><th class="px-4 py-4 font-bold">48 states/DC/territories</th><th class="px-4 py-4 font-bold">Alaska</th><th class="px-4 py-4 font-bold">Hawaii</th></tr></thead><tbody class="divide-y divide-border">{incomeRows.map((row) => <tr><td class="px-4 py-4 font-bold text-foreground">{row.household}</td><td class="px-4 py-4 text-foreground/75">{row.contiguous}</td><td class="px-4 py-4 text-foreground/75">{row.alaska}</td><td class="px-4 py-4 text-foreground/75">{row.hawaii}</td></tr>)}</tbody></table></div>
      </div>
