---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const pageUrl = "https://freetablet.click/";
const siteUrl = "https://freetablet.click";
const isoDate = "2026-06-09";
const displayDate = "June 9, 2026";
const pageTitle = "Free Government Tablet 2026: EBT, Lifeline & Providers";
const pageDescription =
  "Find real free or low-cost tablet options in 2026. Check EBT, Medicaid, Lifeline eligibility, providers, state help and safe apply steps.";

const providerRows = [
  {
    name: "AirTalk Wireless",
    url: "/airtalk-wireless/",
    availability: "May offer tablets or phones when current stock and local rules allow.",
    bestFor: "People comparing Lifeline-connected device offers and online enrollment.",
    note: "Check current stock, ZIP-code availability, co-pay, shipping, and plan terms before applying.",
    cta: "AirTalk Wireless tablet options"
  },
  {
    name: "Assurance Wireless",
    url: "/assurance-wireless/",
    availability: "May offer Lifeline phone service; tablet availability can vary by market.",
    bestFor: "Applicants who want a recognizable Lifeline provider with simple plan information.",
    note: "Device offers are not guaranteed and can change by state, provider policy, and inventory.",
    cta: "Assurance Wireless tablet options"
  },
  {
    name: "SafeLink Wireless",
    url: "/safelink-wireless/",
    availability: "May provide Lifeline phone service and device options depending on eligibility and area.",
    bestFor: "Users comparing SafeLink Wireless phone and tablet options with current provider terms.",
    note: "Confirm current service area, device availability, and activation requirements before enrollment.",
    cta: "SafeLink Wireless phone and tablet options"
  },
  {
    name: "StandUp Wireless",
    url: "/standup-wireless/",
    availability: "May offer Lifeline service and device promotions when available.",
    bestFor: "Applicants who want to compare another provider before choosing where to apply.",
    note: "Availability varies by ZIP code, eligibility path, and provider inventory.",
    cta: "StandUp Wireless tablet options"
  }
];

const faqs = [
  {
    question: "Can I still get a free tablet in 2026?",
    answer:
      "Yes, some eligible people may still find free or low-cost tablet options in 2026 through Lifeline-connected providers, local digital inclusion programs, schools, nonprofits, libraries, or VA telehealth support. Availability depends on your state, ZIP code, eligibility proof, provider stock, and possible co-pay."
  },
  {
    question: "Is there a real government free tablet program?",
    answer:
      "There is no single nationwide free government tablet program for everyone. Real help usually comes through Lifeline service discounts, provider offers, state or local digital inclusion programs, school programs, nonprofits, libraries, or VA telehealth support for eligible veterans."
  },
  {
    question: "Can I get a free tablet with EBT?",
    answer:
      "EBT or SNAP participation may help you qualify for Lifeline or other low-income technology support routes, but it does not automatically guarantee a free tablet. You still need to check provider availability, documents, and ZIP-code rules."
  },
  {
    question: "Can I get a free tablet with Medicaid?",
    answer:
      "Medicaid participation may be a qualifying path for Lifeline eligibility and some related provider offers. Tablet availability still depends on provider stock, state rules, documents, and whether a co-pay or shipping fee applies."
  },
  {
    question: "Can I get a free tablet with internet?",
    answer:
      "Possibly. Some providers may offer a tablet with service, data, or internet support when available, while local programs may focus on device loans or discounted broadband. A free tablet with internet is not guaranteed, so review the plan terms first."
  },
  {
    question: "Can I get a free Android tablet?",
    answer:
      "Many low-cost tablet offers are Android-based because Android tablets are common in entry-level provider and nonprofit programs. The exact model, condition, brand, and availability depend on provider stock, ZIP code, and program rules."
  },
  {
    question: "Can seniors, students, or veterans qualify?",
    answer:
      "Yes, seniors, students, and veterans may qualify through SNAP/EBT, Medicaid, SSI, income-based Lifeline eligibility, school programs, library or nonprofit support, VA telehealth resources, or local digital inclusion programs. Each route has its own rules."
  },
  {
    question: "Is ACP still giving free tablets?",
    answer:
      "No. ACP and the older EBB benefit are no longer active benefit routes for new free tablet help. In 2026, users should check current Lifeline options, provider offers, state programs, nonprofits, schools, libraries, VA telehealth resources, and local digital inclusion programs instead."
  },
  {
    question: "Which providers may offer tablet options?",
    answer:
      "Providers such as AirTalk Wireless, Assurance Wireless, SafeLink Wireless, and StandUp Wireless may have device or service options depending on your area. Current stock, eligibility rules, plan terms, and co-pay details can change, so compare provider pages before applying."
  },
  {
    question: "Do I need to pay a co-pay?",
    answer:
      "You might. Some tablet offers are free, while others may require a small co-pay, shipping charge, activation cost, or service-related fee. A trustworthy provider should explain any cost before you submit or complete an application."
  },
  {
    question: "What documents are needed?",
    answer:
      "Common documents include a government ID, proof of address, proof of SNAP/EBT, Medicaid, SSI, Federal Public Housing Assistance, Veterans Pension, Survivors Benefit, or proof of income. Some applicants may also need a household worksheet or extra identity details where required."
  },
  {
    question: "How do I avoid free tablet scams?",
    answer:
      "Avoid sites that promise guaranteed approval, guaranteed iPads, unusual upfront fees, pressure tactics, or fake government branding. Verify provider terms, Lifeline or National Verifier steps where relevant, and never submit personal information unless the application path looks official and trustworthy."
  }
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "FreeTablet.click",
      "url": `${siteUrl}/`,
      "description": "Independent informational guide for free and low-cost tablet, Lifeline, provider, eligibility, and state assistance options.",
      "email": "support@freetablet.click",
      "sameAs": []
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": `${siteUrl}/`,
      "name": "FreeTablet.click",
      "description": pageDescription,
      "publisher": {
        "@id": `${siteUrl}/#organization`
      },
      "inLanguage": "en-US",
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${siteUrl}/search/?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": pageTitle,
      "headline": "Free Government Tablet 2026: EBT, Lifeline & Provider Options",
      "description": pageDescription,
      "datePublished": isoDate,
      "dateModified": isoDate,
      "reviewedBy": {
        "@id": `${siteUrl}/#organization`
      },
      "isPartOf": {
        "@id": `${siteUrl}/#website`
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": `${siteUrl}/Programs.webp`,
        "caption": "Person checking free government tablet eligibility on a tablet in 2026"
      },
      "about": [
        { "@type": "Thing", "name": "Lifeline" },
        { "@type": "Organization", "name": "Federal Communications Commission", "alternateName": "FCC" },
        { "@type": "Organization", "name": "Universal Service Administrative Company", "alternateName": "USAC" },
        { "@type": "Thing", "name": "National Verifier" },
        { "@type": "Thing", "name": "EBT" },
        { "@type": "Thing", "name": "SNAP" },
        { "@type": "Thing", "name": "Medicaid" },
        { "@type": "Thing", "name": "SSI" },
        { "@type": "Thing", "name": "Veterans Pension" },
        { "@type": "Thing", "name": "Survivors Benefit" },
        { "@type": "Thing", "name": "digital inclusion programs" },
        { "@type": "Thing", "name": "low-income households" },
        { "@type": "Thing", "name": "tablets" },
        { "@type": "Thing", "name": "wireless providers" },
        { "@type": "Thing", "name": "state assistance programs" },
        { "@type": "Thing", "name": "Affordable Connectivity Program", "alternateName": "ACP" },
        { "@type": "Thing", "name": "Emergency Broadband Benefit", "alternateName": "EBB" }
      ],
      "mentions": providerRows.map((provider) => ({
        "@type": "Organization",
        "name": provider.name,
        "url": `${siteUrl}${provider.url}`
      })),
      "inLanguage": "en-US"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": pageUrl
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} modDatetime={new Date("2026-06-09T00:00:00Z")}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <main class="bg-white text-foreground">
    <section class="relative overflow-hidden bg-[#0f172a] text-white">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(37,99,235,0.25),transparent_35%),radial-gradient(circle_at_bottom_left,rgba(14,165,233,0.18),transparent_40%)]"></div>
      <div class="relative mx-auto grid w-full max-w-7xl grid-cols-1 gap-12 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:items-center lg:px-8 lg:py-28">
        <div class="lg:col-span-7 xl:col-span-8">
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-blue-50 shadow-sm">
            <span aria-hidden="true">✓</span>
            <span>Independent guide • Last updated {displayDate}</span>
          </div>

          <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
            Free Government Tablet 2026: <span class="bg-gradient-to-r from-blue-300 to-blue-100 bg-clip-text text-transparent">EBT, Lifeline & Provider Options</span>
          </h1>

          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-blue-100 sm:text-xl">
            Some people may qualify for <strong>free or low-cost tablet options</strong> in 2026 through EBT/SNAP, Medicaid, SSI, income-based Lifeline eligibility, school or local programs, nonprofit support, VA telehealth resources, or participating provider offers.
          </p>

          <p class="mt-4 max-w-3xl text-base leading-relaxed text-blue-200/90">
            Tablet availability depends on your ZIP code, provider stock, eligibility path, documents, shipping rules, and possible co-pay. FreeTablet.click is an independent informational guide, not the government, FCC, USAC, Lifeline, or any wireless provider.
          </p>

          <div class="mt-8 grid max-w-3xl gap-3 sm:grid-cols-2">
            <div class="rounded-xl border border-white/15 bg-white/10 p-4 text-sm font-semibold text-blue-50">EBT/SNAP, Medicaid, SSI, income, and housing benefit paths</div>
            <div class="rounded-xl border border-white/15 bg-white/10 p-4 text-sm font-semibold text-blue-50">Provider stock and tablet offers vary by ZIP code</div>
            <div class="rounded-xl border border-white/15 bg-white/10 p-4 text-sm font-semibold text-blue-50">ACP and EBB are no longer active benefit routes</div>
            <div class="rounded-xl border border-white/15 bg-white/10 p-4 text-sm font-semibold text-blue-50">Safe apply steps, documents, providers, and state help</div>
          </div>

          <div class="mt-10 flex w-full flex-col gap-4 sm:flex-row">
            <a href="/how-to-apply/" class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-8 py-4 text-lg font-bold text-white shadow-xl transition-all duration-300 hover:-translate-y-1 hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
              Apply Now
            </a>
            <a href="/eligibility/" class="inline-flex items-center justify-center rounded-lg border border-white/30 bg-white/5 px-8 py-4 text-lg font-bold text-white transition-all duration-300 hover:bg-white/10">
              Check Eligibility
            </a>
          </div>

          <p class="mt-5 max-w-2xl text-sm leading-relaxed text-blue-200/75">
            Check eligibility, compare provider options, and review possible document requirements before applying. Clicking a button does not guarantee approval or a tablet.
          </p>
        </div>

        <div class="lg:col-span-5 xl:col-span-4">
          <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-4 shadow-2xl">
            <img
              src="/Programs.webp"
              alt="Person checking free government tablet eligibility on a tablet in 2026"
              width="800"
              height="450"
              loading="eager"
              decoding="async"
              class="h-auto w-full rounded-2xl object-cover"
            />
            <div class="mt-4 rounded-2xl bg-white/10 p-5">
              <p class="text-sm font-bold uppercase tracking-wide text-blue-200">2026 tablet help checklist</p>
              <p class="mt-2 text-base leading-relaxed text-white">Eligibility, providers, documents, state availability, co-pay details, and scam warnings in one place.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="quick-answer" class="border-b border-border bg-blue-50/60 py-14">
      <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl border border-blue-100 bg-white p-6 shadow-sm sm:p-8 lg:p-10">
          <p class="mb-3 text-sm font-bold uppercase tracking-wide text-primary-light">Quick Answer</p>
          <h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">Quick Answer: Can You Get a Free Tablet in 2026?</h2>
          <div class="mt-6 space-y-4 text-lg leading-relaxed text-foreground/80">
            <p>
              Yes, some eligible people may still find <strong>free or low-cost tablet options in 2026</strong> through Lifeline-connected providers, local digital inclusion programs, EBT/SNAP or Medicaid eligibility paths, schools, nonprofits, libraries, or VA telehealth support.
            </p>
            <p>
              There is no single nationwide free government tablet program for everyone. Availability depends on your state, ZIP code, provider stock, eligibility proof, and possible co-pay.
            </p>
            <p>
              Start with our <a href="/eligibility/" class="font-bold text-primary-light hover:text-primary">free tablet eligibility</a> guide, then learn how to <a href="/how-to-apply/" class="font-bold text-primary-light hover:text-primary">apply for a free tablet online</a>, compare <a href="/states/" class="font-bold text-primary-light hover:text-primary">free tablet programs by state</a>, and review provider pages such as <a href="/airtalk-wireless/" class="font-bold text-primary-light hover:text-primary">AirTalk Wireless tablet options</a>, <a href="/assurance-wireless/" class="font-bold text-primary-light hover:text-primary">Assurance Wireless tablet options</a>, and <a href="/safelink-wireless/" class="font-bold text-primary-light hover:text-primary">SafeLink Wireless phone and tablet options</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="intent-paths" class="py-16">
      <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-10 max-w-3xl text-center">
          <p class="mb-3 text-sm font-bold uppercase tracking-wide text-primary-light">Find the right path</p>
          <h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">What Type of Free Tablet Help Are You Looking For?</h2>
          <p class="mt-4 text-lg leading-relaxed text-foreground/75">Use this homepage as a starting point for free tablet help, government tablet guidance, application steps, eligibility checks, provider comparison, and local availability by ZIP code.</p>
        </div>

        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-foreground">Core tablet help</h3>
            <p class="mt-3 text-sm leading-relaxed text-foreground/75">If you are comparing free tablets, a government tablet, or a gov tablet option, start by checking which real programs are active in 2026.</p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-foreground">Application help</h3>
            <p class="mt-3 text-sm leading-relaxed text-foreground/75">Learn <a href="/how-to-apply/" class="font-bold text-primary-light hover:text-primary">how to get a free tablet</a>, how to apply for a free tablet, what a free tablet application may ask for, and what to review before enrollment.</p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-foreground">Eligibility paths</h3>
            <p class="mt-3 text-sm leading-relaxed text-foreground/75">Compare free tablet with SNAP, EBT, Medicaid, seniors, students, veterans, and low-income tablet program routes before choosing a provider or local program.</p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-foreground">Device and service needs</h3>
            <p class="mt-3 text-sm leading-relaxed text-foreground/75">Some users need a free Android tablet, a tablet with internet, a tablet with service or data, or a phone and tablet option. These details vary by provider and area.</p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-foreground">Provider choices</h3>
            <p class="mt-3 text-sm leading-relaxed text-foreground/75">Review AirTalk Wireless, Assurance Wireless, SafeLink Wireless, and StandUp Wireless pages to compare current tablet, phone, service, and data options where available.</p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-foreground">Local availability</h3>
            <p class="mt-3 text-sm leading-relaxed text-foreground/75">For local searches like free tablet near me, free tablet by state, or free tablet in Texas, check availability by ZIP code and state before applying.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="best-ways" class="py-20 lg:py-28">
      <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-14 max-w-3xl text-center">
          <p class="mb-3 text-sm font-bold uppercase tracking-wide text-primary-light">2026 options</p>
          <h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl lg:text-5xl">Best Ways to Get a Free or Low-Cost Tablet in 2026</h2>
          <p class="mt-5 text-lg leading-relaxed text-foreground/75">The strongest path depends on your eligibility proof, location, and whether providers or local programs currently have devices available.</p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
          <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
            <h3 class="text-xl font-bold text-foreground">Lifeline provider offers</h3>
            <p class="mt-3 leading-relaxed text-foreground/75">Lifeline is mainly a monthly phone or internet service discount. Some participating providers may attach device offers when inventory and local rules allow.</p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
            <h3 class="text-xl font-bold text-foreground">EBT/SNAP eligibility routes</h3>
            <p class="mt-3 leading-relaxed text-foreground/75">SNAP or EBT participation may help prove eligibility for Lifeline or local low-income technology programs, but it does not guarantee a tablet.</p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
            <h3 class="text-xl font-bold text-foreground">Medicaid eligibility routes</h3>
            <p class="mt-3 leading-relaxed text-foreground/75">Medicaid can be a qualifying program for Lifeline eligibility and may help users access provider or local digital access options.</p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
            <h3 class="text-xl font-bold text-foreground">Local digital inclusion programs</h3>
            <p class="mt-3 leading-relaxed text-foreground/75">Cities, counties, housing agencies, and community partners may offer device loans, refurbished tablets, discounted internet, or digital skills support.</p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
            <h3 class="text-xl font-bold text-foreground">School, nonprofit, and library programs</h3>
            <p class="mt-3 leading-relaxed text-foreground/75">Students, seniors, job seekers, and low-income households may find local help through schools, libraries, nonprofits, and community technology centers.</p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 shadow-sm">
            <h3 class="text-xl font-bold text-foreground">VA telehealth support</h3>
            <p class="mt-3 leading-relaxed text-foreground/75">Eligible veterans who need telehealth access may ask a VA care team about connectivity resources or device support when clinically appropriate.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="who-qualifies" class="border-y border-border bg-muted py-20 lg:py-28">
      <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
        <div class="lg:col-span-5">
          <p class="mb-3 text-sm font-bold uppercase tracking-wide text-primary-light">Eligibility</p>
          <h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">Who May Qualify?</h2>
          <p class="mt-5 text-lg leading-relaxed text-foreground/75">Eligibility usually depends on household income, participation in qualifying benefit programs, provider checks, and state or local program rules.</p>
          <a href="/eligibility/" class="mt-8 inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 font-bold text-white transition-colors hover:bg-primary-light">Check Eligibility</a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
          {["SNAP/EBT", "Medicaid", "SSI", "Federal Public Housing Assistance", "Veterans Pension", "Survivors Benefit", "Income-based Lifeline eligibility", "State or local program rules"].map((item) => (
            <div class="rounded-xl border border-border bg-white p-5 shadow-sm">
              <p class="font-bold text-foreground">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="providers" class="py-20 lg:py-28">
      <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <p class="mb-3 text-sm font-bold uppercase tracking-wide text-primary-light">Compare before applying</p>
          <h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl lg:text-5xl">Provider Comparison</h2>
          <p class="mt-5 text-lg leading-relaxed text-foreground/75">Provider names, plan terms, device inventory, shipping, and co-pay rules can change. Use these links to compare current options before submitting personal information.</p>
        </div>

        <div class="overflow-hidden rounded-2xl border border-border bg-white shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full min-w-[900px] text-left">
              <thead class="bg-[#0f172a] text-white">
                <tr>
                  <th class="px-5 py-4 text-sm font-bold uppercase tracking-wide">Provider</th>
                  <th class="px-5 py-4 text-sm font-bold uppercase tracking-wide">Tablet/Device Availability</th>
                  <th class="px-5 py-4 text-sm font-bold uppercase tracking-wide">Best For</th>
                  <th class="px-5 py-4 text-sm font-bold uppercase tracking-wide">Important Note</th>
                  <th class="px-5 py-4 text-sm font-bold uppercase tracking-wide">CTA</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {providerRows.map((provider) => (
                  <tr class="align-top hover:bg-muted/40">
                    <td class="px-5 py-5 font-bold text-foreground">{provider.name}</td>
                    <td class="px-5 py-5 text-sm leading-relaxed text-foreground/75">{provider.availability}</td>
                    <td class="px-5 py-5 text-sm leading-relaxed text-foreground/75">{provider.bestFor}</td>
                    <td class="px-5 py-5 text-sm leading-relaxed text-foreground/75">{provider.note}</td>
                    <td class="px-5 py-5">
                      <a href={provider.url} class="font-bold text-primary-light hover:text-primary">{provider.cta}</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section id="states" class="border-y border-border bg-blue-50/50 py-20 lg:py-28">
      <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:items-center lg:px-8">
        <div class="lg:col-span-7">
          <p class="mb-3 text-sm font-bold uppercase tracking-wide text-primary-light">Local GEO guidance</p>
