    cta: "SafeLink Wireless phone and tablet options",
  },
];

const faqItems: FaqItem[] = [
  {
    question: "Can I still get a free tablet in 2026?",
    answer:
      "Some eligible people may still find free or low-cost tablet options in 2026 through Lifeline-connected providers, local digital inclusion programs, schools, nonprofits, libraries, or VA telehealth support. Availability depends on state, ZIP code, provider stock, eligibility proof, documents, and possible co-pay.",
  },
  {
    question: "Is there a real government free tablet program?",
    answer:
      "There is no single nationwide free government tablet program for everyone. Real help usually comes through Lifeline service discounts, provider offers, state or local digital inclusion programs, school programs, nonprofits, libraries, or VA telehealth support for eligible veterans.",
  },
  {
    question: "Did ACP end?",
    answer:
      "Yes. ACP ended and the older EBB benefit is also no longer an active benefit route. In 2026, users should check current Lifeline, provider, state, nonprofit, school, library, VA, and local digital inclusion options instead.",
  },
  {
    question: "Can I get a free tablet with EBT or SNAP?",
    answer:
      "EBT or SNAP participation may help prove eligibility for Lifeline or other low-income technology support routes, but it does not automatically guarantee a free tablet. You still need to check provider availability, documents, ZIP-code rules, and possible co-pay.",
  },
  {
    question: "Can I get a free tablet with Medicaid?",
    answer:
      "Medicaid participation may be a qualifying path for Lifeline eligibility and some related provider or local technology offers. Tablet availability still depends on provider stock, state rules, required documents, and whether shipping, activation, or co-pay applies.",
  },
  {
    question: "What income level qualifies for Lifeline?",
    answer:
      "Lifeline eligibility may be available if your household income is at or below 135% of the Federal Poverty Guidelines, or if you participate in qualifying assistance programs such as SNAP, Medicaid, SSI, Federal Public Housing Assistance, Veterans Pension, or Survivors Benefit.",
  },
  {
    question: "Can more than one person in my home get Lifeline?",
    answer:
      "Lifeline generally allows one benefit per household, not one benefit per person. If another adult at your address already receives Lifeline, you may need to show that your household is separate under program rules.",
  },
  {
    question: "Are seniors, students, or veterans eligible?",
    answer:
      "Seniors, students, and veterans may qualify through SNAP/EBT, Medicaid, SSI, income-based Lifeline eligibility, school programs, nonprofit or library support, VA telehealth resources, or local digital inclusion programs. Each route has its own rules.",
  },
  {
    question: "Will I get a free Android tablet or iPad?",
    answer:
      "Most low-cost tablet offers are Android-based because Android tablets are common in entry-level provider and nonprofit programs. A free iPad is not guaranteed and should be treated carefully if a website promises one without clear terms.",
  },
  {
    question: "Are tablets new or refurbished?",
    answer:
      "Both are possible. Some programs or providers may use refurbished devices, while others may offer newer entry-level tablets when available. The exact model, condition, brand, and warranty depend on provider stock and program rules.",
  },
  {
    question: "Can I get a free tablet with internet or data?",
    answer:
      "Possibly. Some providers may offer a tablet with service, data, or internet support when available, while local programs may focus on device loans or discounted broadband. A tablet with internet or data is not guaranteed, so review plan terms first.",
  },
  {
    question: "What documents are needed?",
    answer:
      "Common documents include government ID, proof of address, proof of SNAP/EBT, Medicaid, SSI, housing assistance, veteran benefit, or proof of income. Some applicants may also need household information or extra identity details where required.",
  },
  {
    question: "Do I need to pay a co-pay?",
    answer:
      "You might. Some tablet offers are free, while others may require a small co-pay, shipping charge, activation cost, or service-related fee. A trustworthy provider should explain any cost before you submit or complete an application.",
  },
  {
    question: "How do I avoid free tablet scams?",
    answer:
      "Avoid websites that promise guaranteed approval, guaranteed iPads, unusual upfront fees, fake government branding, pressure tactics, unclear shipping costs, or suspicious document uploads. Verify provider terms and official Lifeline or National Verifier steps where relevant.",
  },
  {
    question: "Do you guarantee approval?",
    answer:
      "No. FreeTablet.click is an independent informational guide. We do not approve applications, issue benefits, guarantee devices, or represent the FCC, USAC, Lifeline, the government, or any provider.",
  },
];

const trustCards: TextCard[] = [
  {
    title: "No Hidden Fees Guidance",
    body: "We explain when a tablet may be free and when a provider may require a co-pay, shipping, activation, or service-related cost.",
  },
  {
    title: "Scam-Safe Guidance",
    body: "We reject guaranteed approval promises, fake free iPad claims, fake government branding, pressure tactics, and suspicious document upload requests.",
  },
  {
    title: "Simple Eligibility Process",
    body: "We break down EBT/SNAP, Medicaid, SSI, housing assistance, veteran benefits, income-based Lifeline eligibility, and local program rules.",
  },
  {
    title: "Updated 2026 Information",
    body: "We clearly explain that ACP and EBB are ended or outdated benefit routes and point users toward current options.",
  },
  {
    title: "State-Specific Help",
    body: "Provider coverage, device stock, co-pay details, and local programs vary by state and ZIP code.",
  },
  {
    title: "Independent Editorial Standards",
    body: "We are not the government, FCC, USAC, Lifeline, or a provider. We organize public program information to help users compare safer options.",
  },
];

const bestWayCards: TextCard[] = [
  {
    title: "Lifeline provider offers",
    body: "Lifeline is mainly a monthly phone or internet service discount. Some participating providers may attach device offers when inventory and local rules allow.",
  },
  {
    title: "EBT/SNAP eligibility routes",
    body: "SNAP or EBT participation may help prove eligibility for Lifeline or local low-income technology programs, but it does not guarantee a tablet.",
  },
  {
    title: "Medicaid eligibility routes",
    body: "Medicaid can be a qualifying program for Lifeline eligibility and may help users access provider or local digital access options.",
  },
