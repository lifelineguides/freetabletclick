---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

type ProviderRow = {
  name: string;
  url: string;
  availability: string;
  bestFor: string;
  note: string;
  cta: string;
};

type FaqItem = {
  question: string;
  answer: string;
};

type TextCard = {
  title: string;
  body: string;
};

type ProgramCard = {
  title: string;
  body: string;
  notes: string[];
};

const pageUrl = "https://freetablet.click/";
const siteUrl = "https://freetablet.click";
const isoDate = "2026-06-09";
const displayDate = "June 9, 2026";
const pageTitle = "Free Government Tablet 2026: EBT, Lifeline & Providers";
const pageDescription =
  "Find real free or low-cost tablet options in 2026. Check EBT, Medicaid, Lifeline eligibility, providers, state help and safe apply steps.";

const providerRows: ProviderRow[] = [
  {
    name: "Assurance Wireless",
    url: "/assurance-wireless/",
    availability: "May offer Lifeline phone service and device options when available.",
    bestFor: "Applicants comparing a recognizable Lifeline provider.",
    note: "Device offers are not guaranteed and vary by ZIP code, stock, eligibility, and provider terms.",
    cta: "Assurance Wireless tablet options",
  },
  {
    name: "AirTalk Wireless",
    url: "/airtalk-wireless/",
    availability: "May offer tablets or phones when current stock and local rules allow.",
    bestFor: "People comparing Lifeline-connected device offers and online enrollment.",
    note: "Check current stock, possible co-pay, shipping, activation, and plan terms before applying.",
    cta: "AirTalk Wireless tablet options",
  },
  {
    name: "StandUp Wireless",
    url: "/standup-wireless/",
    availability: "May offer Lifeline service and device promotions when available.",
    bestFor: "Applicants who want another provider to compare before choosing.",
    note: "Availability changes by ZIP code, eligibility path, provider policy, and inventory.",
