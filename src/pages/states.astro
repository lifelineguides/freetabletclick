const faqItems: FaqItem[] = [
  { question: "How do I find a free tablet in my state?", answer: "Start by checking Lifeline eligibility, then compare providers by ZIP code using official/provider tools. Tablet options are not guaranteed in every state and depend on provider inventory, local program funding, shipping, activation, plan terms, and possible co-pay." },
  { question: "Can I get a free tablet with EBT in my state?", answer: "SNAP or EBT participation may help prove Lifeline eligibility, but it does not automatically guarantee a tablet. Availability depends on your state, ZIP code, provider terms, inventory, documents, and any possible co-pay." },
  { question: "Can I get a free tablet with Medicaid in my state?", answer: "Medicaid may be a Lifeline eligibility route in many states, but tablet availability is still provider-dependent. Check ZIP-code coverage, current device offers, documents, shipping, activation, and plan terms before applying." },
  { question: "Are Lifeline tablet providers different in every state?", answer: "Yes. Lifeline is federal, but participating wireless providers, service areas, device offers, and application handling can differ by state and ZIP code." },
  { question: "What is the best state for free tablet programs?", answer: "There is no single best state for everyone. The best option depends on your ZIP code, eligibility route, local digital inclusion programs, provider stock, shipping, activation, data terms, and possible co-pay." },
  { question: "Can I get a free tablet near me?", answer: "Possibly, but it is not guaranteed. Use your state and ZIP code to compare Lifeline providers, local libraries, schools, nonprofits, and city or county digital inclusion programs." },
  { question: "Why do some providers not show in my ZIP code?", answer: "Providers may serve only certain states, networks, counties, or ZIP codes. Device availability, tablet stock, shipping, activation, and plan terms may also vary by service area." },
  { question: "Do all states offer free tablets?", answer: "No. Some states or ZIP codes may have provider tablet offers or local device programs, while others may only show phone service or discounted connectivity options." },
  { question: "Are state tablet programs the same as ACP?", answer: "No. State or local device programs are separate from ACP. ACP and EBB are no longer active benefit routes for new tablet help, so users should check current Lifeline, provider, school, library, nonprofit, VA, and local options." },
  { question: "Did ACP end?", answer: "Yes. ACP ended and EBB is also no longer an active benefit route. Do not rely on outdated ACP pages that make tablet benefits sound currently active." },
  { question: "Can seniors get a free tablet by state?", answer: "Seniors may find help through Medicaid, SSI, SNAP/EBT, income-based Lifeline, local aging programs, libraries, nonprofits, or VA support where applicable. Tablet availability still varies by state and ZIP code." },
  { question: "Can students get a free tablet by state?", answer: "Students may find tablet or device help through schools, colleges, libraries, nonprofits, local digital inclusion programs, or provider options when available. Eligibility and funding vary by state and locality." },
  { question: "Can veterans get a free tablet by state?", answer: "Veterans may check Lifeline eligibility through Veterans Pension or Survivors Benefit, VA telehealth support, nonprofit programs, libraries, or local digital inclusion resources. Device support is not guaranteed." },
  { question: "Do Tribal lands have extra Lifeline support?", answer: "Qualifying Tribal lands may receive up to $34.25 in monthly Lifeline support where applicable, but this is not a guaranteed tablet benefit. Address verification and provider availability still matter." },
  { question: "What documents do I need for a state application?", answer: "Common documents include government ID, proof of address, proof of SNAP/EBT, Medicaid, SSI, FPHA, Veterans benefit, income proof, household details, Tribal documents where applicable, or extra identity details if requested." },
  { question: "Should I use National Verifier or provider websites?", answer: "Use official Lifeline/National Verifier or state-specific eligibility tools when required, then use provider websites to check service area, plan terms, device options, shipping, activation, and possible co-pay." },
  { question: "Can I keep my tablet if I move to another state?", answer: "Rules depend on provider terms, service area, eligibility, and recertification. If you move, update your address with the provider and verify whether your plan, service, and device terms remain valid." },
  { question: "What if my state page is not ready yet?", answer: "Use the state anchor on this directory, check official Lifeline provider lookup by ZIP code, compare provider pages, and review eligibility and application steps. This page avoids fake state pages and uses same-page state notes when a dedicated state page is not available." },
];

