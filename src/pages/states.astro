  <script is:inline>
    (() => {
      const input = document.getElementById("state-search");
      const cards = Array.from(document.querySelectorAll("[data-state-card]"));
      if (!input || !cards.length) return;
      input.addEventListener("input", () => {
        const query = input.value.trim().toLowerCase();
        cards.forEach((card) => {
          const haystack = (card.getAttribute("data-state-search") || card.textContent || "").toLowerCase();
          card.style.display = haystack.includes(query) ? "" : "none";
        });
      });
    })();
  </script>

