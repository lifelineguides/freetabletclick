---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const pageUrl = "https://freetablet.click/contact/";
const siteUrl = "https://freetablet.click";
const pageTitle = "Contact FreeTablet.click: Support, Corrections & Safety";
const pageDescription =
  "Contact FreeTablet.click for corrections, editorial feedback, scam reports and guidance questions. We are independent and cannot manage provider accounts.";
const isoDate = "2026-06-09";
const displayDate = "June 9, 2026";

const contactCards = [
  {
    title: "Editorial corrections",
    body: "Report outdated eligibility wording, broken official links, provider term changes, unsafe claims, or pages that need clearer source context.",
    action: "mailto:support@freetablet.click?subject=Correction%20request%20for%20FreeTablet.click",
    label: "Send correction request",
  },
  {
    title: "General guidance questions",
    body: "Ask general questions about eligibility, documents, safe application paths, state availability, provider comparison, or scam warning content.",
    action: "mailto:info@freetablet.click?subject=General%20question%20for%20FreeTablet.click",
    label: "Ask a question",
  },
  {
    title: "Scam or suspicious page report",
    body: "Tell us about fake tablet pages, guaranteed approval claims, fake ACP offers, fake shipping fee traps, or social media forms asking for sensitive data.",
    action: "mailto:support@freetablet.click?subject=Scam%20or%20suspicious%20tablet%20page%20report",
    label: "Report scam concern",
  },
];

const weCanHelp = [
  "Explain general Lifeline eligibility and document concepts.",
  "Point you to official Lifeline, USAC, FCC, National Verifier, or provider resources.",
  "Clarify why a page should not promise guaranteed approval or a guaranteed free tablet.",
  "Review feedback about outdated provider terms or broken links.",
  "Improve safety warnings when users report scam patterns.",
];

const cannotHelp = [
  "We cannot approve Lifeline applications or issue benefits.",
  "We cannot check application status, order tracking, shipping, activation, or warranty cases.",
  "We cannot access provider accounts or National Verifier accounts.",
  "We cannot ship tablets, phones, SIM cards, or internet devices.",
  "We cannot guarantee a free tablet, free phone, approval, shipping timeline, data plan, or co-pay amount.",
];

const officialSupport = [
  {
    title: "Lifeline Support Center",
    body: "For official Lifeline application help, eligibility questions, accessibility assistance, or mail application support.",
    contact: "1-800-234-9473",
    href: "tel:18002349473",
  },
  {
    title: "FCC Consumer Center",
    body: "For consumer complaints, Lifeline-related consumer information, or federal communications questions.",
    contact: "1-888-225-5322",
    href: "tel:18882255322",
  },
  {
    title: "National Verifier / Check Lifeline",
    body: "For official online Lifeline eligibility checking where available.",
    contact: "checklifeline.org",
    href: "https://www.checklifeline.org/",
  },
  {
    title: "USAC Companies Near Me",
    body: "For finding Lifeline providers by state, ZIP code, and service area.",
    contact: "lifelinesupport.org/companies-near-me",
    href: "https://www.lifelinesupport.org/companies-near-me/",
  },
];

const beforeEmail = [
  "The page URL or provider name you are asking about.",
  "Whether you are reporting outdated wording, a broken link, a scam concern, or a general question.",
  "A short summary of what looks wrong or confusing.",
  "Do not send full SSN, full ID photos, passwords, benefit account logins, or private provider account details.",
];

const safeLinks = [
  { title: "Free government tablet guide", href: "/", body: "Start with the main overview and safe wording rules." },
  { title: "Free tablet eligibility", href: "/eligibility/", body: "Check EBT, Medicaid, SNAP, SSI, income, household, and document rules." },
  { title: "Apply safely", href: "/how-to-apply/", body: "Use official/provider application paths and avoid scams." },
  { title: "Tablet availability by state", href: "/states/", body: "Compare ZIP-code and state availability notes." },
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "FreeTablet.click",
      "url": `${siteUrl}/`,
      "email": "support@freetablet.click",
      "description": "Independent informational guide for Lifeline, free and low-cost tablet options, eligibility, application steps, provider comparisons, state availability, and scam safety.",
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "editorial corrections and general information",
          "email": "support@freetablet.click",
          "availableLanguage": "en-US",
        },
        {
          "@type": "ContactPoint",
          "contactType": "general information",
          "email": "info@freetablet.click",
          "availableLanguage": "en-US",
        },
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": `${siteUrl}/`,
      "name": "FreeTablet.click",
      "description": "Independent free and low-cost tablet, Lifeline, provider, eligibility, application, state availability, and scam safety guide.",
      "publisher": { "@id": `${siteUrl}/#organization` },
      "inLanguage": "en-US",
    },
    {
      "@type": "ContactPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": pageTitle,
      "headline": "Contact FreeTablet.click: Support, Corrections & Safety",
      "description": pageDescription,
      "datePublished": isoDate,
      "dateModified": isoDate,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "publisher": { "@id": `${siteUrl}/#organization` },
      "about": [
        { "@type": "Thing", "name": "Lifeline support" },
        { "@type": "Thing", "name": "editorial corrections" },
        { "@type": "Thing", "name": "scam reports" },
        { "@type": "Thing", "name": "provider account support boundaries" },
        { "@type": "Thing", "name": "YMYL-safe benefits guidance" },
        { "@type": "Organization", "name": "Federal Communications Commission", "alternateName": "FCC" },
        { "@type": "Organization", "name": "Universal Service Administrative Company", "alternateName": "USAC" },
        { "@type": "Thing", "name": "National Verifier" }
      ],
      "inLanguage": "en-US",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": pageUrl }
      ],
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} modDatetime={new Date("2026-06-09T00:00:00Z")} structuredData={schemaGraph}>
  <Header />

  <main id="main-content" class="flex w-full flex-1 flex-col items-center">
    <section class="relative flex w-full flex-col items-center justify-center overflow-hidden bg-[#0f172a] pt-20 pb-24 text-white lg:pt-28 lg:pb-32" style="background-image: radial-gradient(circle at top right, rgba(37, 99, 235, 0.16), transparent 42%), radial-gradient(circle at bottom left, rgba(168, 85, 247, 0.16), transparent 42%);">
      <div class="relative z-10 mx-auto w-full max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-sm font-semibold text-blue-100 shadow-sm">
          <span>Contact, corrections & safety • Last updated {displayDate}</span>
        </div>
        <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">Contact FreeTablet.click</h1>
        <p class="mx-auto mt-6 max-w-4xl text-lg leading-relaxed font-medium text-blue-100 sm:text-xl">
          Contact us for editorial corrections, broken links, scam concerns, general guidance questions, and feedback about Lifeline, free or low-cost tablet eligibility, provider pages, state availability, and application safety.
        </p>
        <p class="mx-auto mt-6 max-w-3xl text-xs leading-relaxed text-blue-200/70">
          FreeTablet.click is independent. We are not the FCC, USAC, Lifeline, National Verifier, a government agency, or a wireless provider. We cannot approve applications, issue benefits, ship devices, or manage provider accounts.
        </p>
      </div>
    </section>

    <section class="w-full border-b border-border bg-blue-50/60 py-14">
      <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl border border-blue-100 bg-white p-6 shadow-sm sm:p-8 lg:p-10">
          <p class="mb-3 text-sm font-bold tracking-wide text-blue-600 uppercase">Quick note</p>
          <h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">Use the Right Support Channel</h2>
          <p class="mt-5 text-lg leading-relaxed text-foreground/80">We can help improve and clarify public information on this website. For private account issues like application status, shipping, activation, SIM problems, device warranty, provider login, or order tracking, contact your provider or the official Lifeline support channel directly.</p>
        </div>
      </div>
    </section>

    <section class="w-full bg-muted/30 py-16 lg:py-24">
      <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-6 md:grid-cols-3">
          {contactCards.map((card) => <div class="flex rounded-3xl border border-border bg-white p-8 shadow-sm"><div class="flex h-full flex-col"><h2 class="text-2xl font-extrabold text-foreground">{card.title}</h2><p class="mt-4 flex-grow leading-relaxed text-foreground/75">{card.body}</p><a href={card.action} class="mt-6 inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-3 font-bold text-white hover:bg-blue-700">{card.label}</a></div></div>)}
        </div>
      </div>
    </section>

    <section class="w-full border-y border-border bg-white py-16 lg:py-24">
      <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
        <div class="rounded-3xl border border-border bg-muted/30 p-8 shadow-sm">
          <h2 class="text-3xl font-extrabold tracking-tight text-foreground">What We Can Help With</h2>
          <ul class="mt-6 space-y-4 text-foreground/75">
            {weCanHelp.map((item) => <li class="flex gap-3 leading-relaxed"><span class="mt-1 text-blue-600">✓</span><span>{item}</span></li>)}
          </ul>
        </div>
        <div class="rounded-3xl border border-red-100 bg-red-50/60 p-8 shadow-sm">
          <h2 class="text-3xl font-extrabold tracking-tight text-foreground">What We Cannot Do</h2>
          <ul class="mt-6 space-y-4 text-foreground/75">
            {cannotHelp.map((item) => <li class="flex gap-3 leading-relaxed"><span class="mt-1 text-red-600">!</span><span>{item}</span></li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="w-full bg-muted/30 py-16 lg:py-24">
      <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-12 max-w-3xl text-center"><p class="mb-3 text-sm font-bold tracking-wide text-blue-600 uppercase">Official support</p><h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">Official Lifeline and Provider Support Paths</h2><p class="mt-5 text-lg leading-relaxed text-foreground/75">Use these channels for official Lifeline or provider-related help. These are not FreeTablet.click support lines.</p></div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {officialSupport.map((item) => <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined} class="rounded-2xl border border-border bg-white p-6 shadow-sm hover:bg-blue-50"><h3 class="text-xl font-bold text-foreground">{item.title}</h3><p class="mt-3 text-sm leading-relaxed text-foreground/75">{item.body}</p><p class="mt-4 font-bold text-blue-600">{item.contact}</p></a>)}
        </div>
      </div>
    </section>

    <section class="w-full border-y border-border bg-blue-50/60 py-16 lg:py-24">
      <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
        <div class="lg:col-span-5"><p class="mb-3 text-sm font-bold tracking-wide text-blue-600 uppercase">Before emailing</p><h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">What to Include in Your Message</h2><p class="mt-5 text-lg leading-relaxed text-foreground/75">Please protect your privacy. We do not need sensitive documents to answer general questions or review corrections.</p></div>
        <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
          {beforeEmail.map((item) => <div class="rounded-xl border border-blue-100 bg-white p-5 shadow-sm"><p class="font-bold text-foreground">{item}</p></div>)}
        </div>
      </div>
    </section>

    <section class="w-full bg-white py-16 lg:py-24">
      <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-12 max-w-3xl text-center"><p class="mb-3 text-sm font-bold tracking-wide text-blue-600 uppercase">Helpful pages</p><h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">Find Answers Faster</h2></div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {safeLinks.map((item) => <a href={item.href} class="rounded-2xl border border-border bg-muted/30 p-6 shadow-sm hover:bg-blue-50"><h3 class="text-xl font-bold text-foreground">{item.title}</h3><p class="mt-3 text-sm leading-relaxed text-foreground/75">{item.body}</p></a>)}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
